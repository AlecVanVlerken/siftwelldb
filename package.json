{
  "name": "siftwelldb",
  "version": "1.0.1",
  "description": "SiftwellDB document database with semantic search and a browser client",
  "license": "ISC",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --exclude '**/benchmarks/**'",
    "coverage": "vitest run --coverage --exclude '**/benchmarks/**'",
    "build": "npm run clean && tsc --noEmit && tsc --project tsconfig.build.json && npm run build:webclient-frontend && node scripts/build-assets.mjs",
    "build:webclient-frontend": "tsc --project tsconfig.webclient-frontend.json",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint src/ tests/ examples/ benchmarks/ scripts/ vitest.config.mts",
    "lint-fix": "eslint --fix src/ tests/ examples/ benchmarks/ scripts/ vitest.config.mts",
    "prettier-check": "prettier --check src/ tests/ examples/ benchmarks/ scripts/ *.json *.mjs vitest.config.mts README.md .gitlab-ci.yml",
    "prettier-fix": "prettier --write src/ tests/ examples/ benchmarks/ scripts/ *.json *.mjs vitest.config.mts README.md .gitlab-ci.yml",
    "demo:map": "tsx examples/semantic-map.mts",
    "demo": "tsx examples/semantic-search.mts",
    "demo:images": "tsx examples/semantic-image-search.mts",
    "benchmark:compression": "tsx benchmarks/compression/recordstore-benchmark.mts",
    "benchmark:pagination": "tsx benchmarks/large-dataset/pagination-benchmark.mts",
    "benchmark:btree": "vitest run benchmarks/btree --fileParallelism=false",
    "benchmark:dbms": "vitest run benchmarks/dbms/insert_overhead.spec.mts --fileParallelism=false",
    "benchmark:embeddings": "vitest run benchmarks/dbms/embedding_speed.spec.mts --fileParallelism=false",
    "benchmark:hnsw": "vitest run benchmarks/hnsw --fileParallelism=false",
    "benchmark:vacuum": "tsx benchmarks/full-vacuum/vacuum-benchmark.mts",
    "benchmark:incremental": "tsx benchmarks/incremental-compaction/run-all-benchmarks.mts",
    "benchmark:incremental:core": "tsx benchmarks/incremental-compaction/core/run-core-benchmarks.mts",
    "benchmark:incremental:relocation": "tsx benchmarks/incremental-compaction/relocation/run-relocation-benchmarks.mts",
    "benchmark:incremental:consistency": "tsx benchmarks/incremental-compaction/consistency/run-consistency-benchmarks.mts",
    "benchmark:incremental:durability": "tsx benchmarks/incremental-compaction/durability/run-durability-benchmarks.mts",
    "benchmark:incremental:maintenance": "tsx benchmarks/incremental-compaction/maintenance/run-maintenance-benchmarks.mts",
    "benchmark:incremental:overhead": "tsx benchmarks/incremental-compaction/performance/compaction-overhead-benchmark.mts",
    "benchmark:incremental:performance": "tsx benchmarks/incremental-compaction/performance/run-performance-benchmarks.mts",
    "benchmark:incremental:adversarial": "tsx benchmarks/incremental-compaction/adversarial/run-adversarial-benchmarks.mts",
    "benchmark:incremental:k-convergence": "tsx benchmarks/incremental-compaction/core/k-convergence-benchmark.mts",
    "benchmark:incremental:heavy-delete": "tsx benchmarks/incremental-compaction/core/heavy-delete-benchmark.mts",
    "benchmark:incremental:mixed-churn": "tsx benchmarks/incremental-compaction/core/mixed-churn-benchmark.mts",
    "benchmark:incremental:mixed-tail": "tsx benchmarks/incremental-compaction/core/mixed-tail-blockers-benchmark.mts",
    "benchmark:incremental:recordstore": "tsx benchmarks/incremental-compaction/relocation/recordstore-benchmark.mts",
    "benchmark:incremental:btree": "tsx benchmarks/incremental-compaction/relocation/btree-benchmark.mts",
    "benchmark:incremental:btree-dominant": "tsx benchmarks/incremental-compaction/relocation/btree-dominant-tail-blocker-benchmark.mts",
    "benchmark:incremental:btree-sequence": "tsx benchmarks/incremental-compaction/relocation/btree-tail-clear-sequence-benchmark.mts",
    "benchmark:incremental:hnsw": "tsx benchmarks/incremental-compaction/relocation/hnsw-benchmark.mts",
    "benchmark:incremental:hnsw-dominant": "tsx benchmarks/incremental-compaction/relocation/hnsw-dominant-tail-blocker-benchmark.mts",
    "benchmark:incremental:hnsw-sequence": "tsx benchmarks/incremental-compaction/relocation/hnsw-tail-clear-sequence-benchmark.mts",
    "benchmark:incremental:ordered-mixed": "tsx benchmarks/incremental-compaction/relocation/ordered-mixed-tail-blockers-benchmark.mts",
    "benchmark:incremental:mixed-minimized": "tsx benchmarks/incremental-compaction/relocation/mixed-blockers-with-records-minimized-benchmark.mts",
    "benchmark:incremental:record-btree-reference": "tsx benchmarks/incremental-compaction/consistency/record-btree-reference-benchmark.mts",
    "benchmark:incremental:record-hnsw-reference": "tsx benchmarks/incremental-compaction/consistency/record-hnsw-reference-benchmark.mts",
    "benchmark:incremental:hnsw-semantic-equivalence": "tsx benchmarks/incremental-compaction/consistency/hnsw-semantic-equivalence-benchmark.mts",
    "benchmark:incremental:mixed-durability": "tsx benchmarks/incremental-compaction/durability/mixed-durability-benchmark.mts",
    "benchmark:incremental:long-run-idle": "tsx benchmarks/incremental-compaction/maintenance/long-run-idle-maintenance-benchmark.mts",
    "benchmark:incremental:maintenance-stability": "tsx benchmarks/incremental-compaction/maintenance/maintenance-stability-benchmark.mts",
    "benchmark:incremental:rolling-churn": "tsx benchmarks/incremental-compaction/maintenance/rolling-churn-benchmark.mts",
    "benchmark:incremental:plateau-fallback": "tsx benchmarks/incremental-compaction/maintenance/plateau-fallback-benchmark.mts",
    "benchmark:incremental:noop-plateau": "tsx benchmarks/incremental-compaction/maintenance/noop-plateau-benchmark.mts",
    "benchmark:incremental:bounded-idle": "tsx benchmarks/incremental-compaction/maintenance/bounded-idle-benchmark.mts",
    "benchmark:incremental:performance-single": "tsx benchmarks/incremental-compaction/performance/performance-benchmark.mts",
    "benchmark:incremental:adversarial-single": "tsx benchmarks/incremental-compaction/adversarial/adversarial-benchmark.mts",
    "benchmark:incremental:plot": "python benchmarks/incremental-compaction/plotting/plot_incremental_compaction.py",
    "cli": "tsx src/query/cli.mts",
    "test:reference": "tsx examples/tests/reference-document-store.test.mts",
    "start": "node build/webclient/server/daemon.mjs",
    "start:dev": "tsx src/webclient/server/daemon.mts",
    "seed:test": "tsx scripts/seed-test-database.mts",
    "seed:articles": "tsx scripts/seed-articles.mts",
    "import:wikipedia": "tsx scripts/import-wikipedia.mts",
    "index:content": "tsx scripts/build-content-index.mts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "4.0.6",
    "eslint": "9.39.0",
    "prettier": "3.6.2",
    "random": "5.4.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.0.6"
  },
  "dependencies": {
    "@emnapi/runtime": "1.10.0",
    "@google/genai": "2.0.1",
    "@huggingface/transformers": "3.8.1",
    "dotenv": "17.4.2",
    "koffi": "2.15.2"
  }
}
