{
  "explores": [
    {
      "collection": "employees",
      "label": "Employee Records",
      "description": "Employee records including salary, department, seniority, gender, age, city, and tenure",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "label": "Employee ID",
          "description": "Unique identifier for each employee",
          "hidden": true
        },
        {
          "name": "name",
          "type": "string",
          "label": "Full Name",
          "description": "The employee's full name",
          "synonyms": ["employee", "person", "worker"]
        },
        {
          "name": "gender",
          "type": "string",
          "label": "Gender",
          "description": "Employee's gender — values are 'M' or 'F'",
          "synonyms": ["sex"]
        },
        {
          "name": "department",
          "type": "string",
          "label": "Department",
          "description": "Department the employee belongs to (Engineering, Marketing, Sales, HR, Finance, Operations, Support, Legal)",
          "synonyms": ["dept", "team", "division"]
        },
        {
          "name": "seniority",
          "type": "string",
          "label": "Seniority Level",
          "description": "Career level: Junior, Mid, Senior, Lead, or Principal",
          "synonyms": ["level", "rank", "experience", "career level"]
        },
        {
          "name": "salary",
          "type": "number",
          "label": "Annual Salary",
          "description": "Gross annual salary in EUR",
          "synonyms": ["pay", "wage", "compensation", "income", "earnings"],
          "tags": ["compensation", "finance"]
        },
        {
          "name": "age",
          "type": "number",
          "label": "Age",
          "description": "Employee's age in years"
        },
        {
          "name": "city",
          "type": "string",
          "label": "City",
          "description": "City where the employee is based (Leuven, Gent, Antwerpen, Brussel, Brugge, Mechelen, Hasselt, Namur)",
          "synonyms": ["location", "office", "site"]
        },
        {
          "name": "yearsAtCompany",
          "type": "number",
          "label": "Years at Company",
          "description": "Number of full years the employee has been with the company",
          "synonyms": ["tenure", "years employed", "seniority years"]
        }
      ],
      "measures": [
        {
          "name": "headcount",
          "label": "Headcount",
          "aggregation": "COUNT",
          "field": "*",
          "description": "Number of employees"
        },
        {
          "name": "average_salary",
          "label": "Average Salary",
          "aggregation": "AVG",
          "field": "salary",
          "description": "Mean gross annual salary in EUR"
        },
        {
          "name": "total_salary",
          "label": "Total Salary Cost",
          "aggregation": "SUM",
          "field": "salary",
          "description": "Sum of all gross annual salaries in EUR"
        },
        {
          "name": "max_salary",
          "label": "Highest Salary",
          "aggregation": "MAX",
          "field": "salary"
        },
        {
          "name": "min_salary",
          "label": "Lowest Salary",
          "aggregation": "MIN",
          "field": "salary"
        },
        {
          "name": "avg_age",
          "label": "Average Age",
          "aggregation": "AVG",
          "field": "age"
        },
        {
          "name": "avg_tenure",
          "label": "Average Tenure",
          "aggregation": "AVG",
          "field": "yearsAtCompany",
          "description": "Average years employees have been with the company"
        }
      ]
    }
  ]
}
